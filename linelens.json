{
  "default": {
    "maxLines": 100
  },
  "rules": [
    { "pattern": "**/*_test.go",       "maxLines": 300 },
    { "pattern": "**/*.spec.*",        "maxLines": 300 },
    { "pattern": "**/*.test.*",        "maxLines": 300 },
    { "pattern": "**/migrations/**",   "skip": true },
    { "pattern": "**/*.generated.*",   "skip": true },
    { "pattern": "**/*.min.*",         "skip": true },
    { "pattern": "**/*.md",            "skip": true },
    { "pattern": "**/*.out",           "skip": true },
    { "pattern": "**/*.egg-info/**",   "skip": true },
    { "pattern": "**/__pycache__/**",  "skip": true },
    { "pattern": ".agent/feature-list.json", "maxLines": 500 }
  ],
  "exclude": [
    "node_modules",
    "vendor",
    ".git",
    "dist",
    "build",
    ".cache",
    "tools/linelens/linelens"
  ]
}
