# ─── Binarios compilados de tools ───────────────────────────────────────────
# Binarios sueltos en la raíz (go build ./tools/<t> desde la raíz deja el binario acá)
/linelens
/dupelens
/secretlens
/testlens
/scopelens
# Agregar una línea por cada tool al añadirlo al monorepo
tools/linelens/linelens
tools/linelens/linelens.exe
tools/dupelens/dupelens
tools/dupelens/dupelens.exe
tools/secretlens/secretlens
tools/secretlens/secretlens.exe
tools/testlens/testlens
tools/testlens/testlens.exe
tools/scopelens/scopelens
tools/scopelens/scopelens.exe

# Binarios npm cross-compiled
npm/@open_harness/secretlens-*/bin/secretlens
npm/@open_harness/secretlens-win32-x64/bin/secretlens.exe
npm/@open_harness/testlens-*/bin/testlens
npm/@open_harness/testlens-win32-x64/bin/testlens.exe

# Binarios de distribución npm (se generan con scripts/build-npm.sh)
npm/@open_harness/linelens-*/bin/linelens
npm/@open_harness/linelens-win32-x64/bin/linelens.exe
npm/@open_harness/dupelens-*/bin/dupelens
npm/@open_harness/dupelens-win32-x64/bin/dupelens.exe
npm/@open_harness/scopelens-*/bin/scopelens
npm/@open_harness/scopelens-win32-x64/bin/scopelens.exe

# Carpeta de distribución general
dist/

# ─── Go ─────────────────────────────────────────────────────────────────────
go.work.sum
coverage.out
coverage.html
**/*.test

# ─── Node / npm ─────────────────────────────────────────────────────────────
node_modules/
*.log
npm-debug.log*

# ─── Skills ─────────────────────────────────────────────────────────────────
*.skill

# ─── Entorno y secretos ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Editores y OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~


# Native binaries staged for pypi wheel builds
pypi/open_harness_*/src/open_harness_*/bin/*
!pypi/open_harness_*/src/open_harness_*/bin/.gitkeep
pypi/**/dist/
pypi/**/build/
pypi/**/*.egg-info/
__pycache__/
*.pyc
