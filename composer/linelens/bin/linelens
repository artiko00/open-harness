#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Composer shim: delegates argv to the native binary installed by
 * OpenHarness\Linelens\BinaryDownloader during post-install.
 */

$tool = 'linelens';
$ext  = PHP_OS_FAMILY === 'Windows' ? '.exe' : '';

// composer places this file in vendor/open-harness/<tool>/bin/<tool>.
// The native binary lives in vendor/bin/ alongside other composer bins.
$thisDir = __DIR__;
$candidates = [
    dirname($thisDir, 3) . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . $tool . $ext,
    dirname($thisDir, 4) . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . $tool . $ext,
    $thisDir . DIRECTORY_SEPARATOR . $tool . $ext,
];

$binary = null;
foreach ($candidates as $c) {
    if (is_file($c) && is_executable($c)) { $binary = $c; break; }
}

if ($binary === null) {
    fwrite(STDERR, "{$tool}: native binary not found. Did the composer post-install hook run?\n");
    fwrite(STDERR, "Try:  composer reinstall open-harness/{$tool}\n");
    exit(1);
}

$args = array_slice($argv, 1);
$quoted = array_map('escapeshellarg', $args);
$cmd = escapeshellcmd($binary) . ' ' . implode(' ', $quoted);
passthru($cmd, $exit);
exit($exit ?? 0);
