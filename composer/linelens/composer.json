{
  "name": "open-harness/linelens",
  "description": "File length linter for any language \u2014 single native binary, zero runtime deps.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "linter",
    "code-quality",
    "lines",
    "pre-commit",
    "ci"
  ],
  "homepage": "https://github.com/artiko00/open-harness",
  "authors": [
    {
      "name": "Jassen Castillo",
      "email": "castillo.cristianj@gmail.com"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "bin": [
    "bin/linelens"
  ],
  "autoload": {
    "psr-4": {
      "OpenHarness\\Linelens\\": "src/"
    }
  },
  "scripts": {
    "post-install-cmd": "OpenHarness\\Linelens\\BinaryDownloader::install",
    "post-update-cmd": "OpenHarness\\Linelens\\BinaryDownloader::install"
  },
  "extra": {
    "open-harness": {
      "tool": "linelens",
      "version": "0.2.1"
    }
  }
}
